NODE_ENV=development
SERVICE_NAME=m2r-email-api
LOG_LEVEL=info
PORT=3009
URL_PREFIX=/api/v1
URL_INTERNAL=http://localhost:3009
URL_EXTERNAL=http://localhost:3009

# ScyllaDB
SCYLLA_HOSTS=localhost
SCYLLA_DATACENTER=datacenter1
SCYLLA_USERNAME=
SCYLLA_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# RabbitMQ
AMQP_URL=amqp://m2ria:m2ria_dev@localhost:5672
AMQP_EXCHANGE=m2ria.email
AMQP_DLX_EXCHANGE=m2ria.dlx
AMQP_QUEUE=m2r-email-api.send
AMQP_BINDINGS=email.send.#
AMQP_PREFETCH=10

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULER_BATCH=100

# Crypto / Auth
M2R_CRYPTO_KEY=
INTEGRATION_CACHE_TTL_SECONDS=300
JWT_SECRET=dev-secret-change-in-production

# Swagger
SWAGGER_AUTH_ENABLED=false
SWAGGER_USERNAME=m2radmin
SWAGGER_PASSWORD=iav4idom

# Sender
SENDER_DEFAULT_TIMEOUT_MS=30000
