# =================================================
#  Variaveis Globais
# =================================================
# ScyllaDB
# =================================================
SCYLLA_HOSTS=localhost
SCYLLA_DATACENTER=datacenter1
SCYLLA_KEYSPACE=system
SCYLLA_USERNAME=cassandra
SCYLLA_PASSWORD=cassandra
SCYLLA_PORT=9042

# =================================================
# Redis
# =================================================
REDIS_HOSTS=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# =================================================
# RabbitMQ
# =================================================
RABBITMQ_HOSTS=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
AMQP_URL=amqp://guest:guest@localhost:5672

# =================================================
# Seguranca
# =================================================
JWT_SECRET=change-me
M2R_CRYPTO_KEY=change-me
NODE_AUTH_TOKEN=change-me

# =================================================
# Swagger
# =================================================
SWAGGER_AUTH_ENABLED=false
SWAGGER_USERNAME=m2radmin
SWAGGER_PASSWORD=change-me

# =================================================
# Ambiente
# =================================================
NODE_ENV=development
LOG_LEVEL=info

# =================================================
# Mensageria / URLs Publicas
# =================================================
EMAIL_EXCHANGE=m2ria.email
EMAIL_ROUTING_KEY_GPM=email.send.gpm
TENANT_EXCHANGE=m2ria.tenant
APPWEB_PUBLIC_URL=http://localhost:3000
GPM_PUBLIC_URL=http://localhost:3010

# =================================================
#  Variaveis especificas do EMAIL_API
# =================================================
# Servidor
# =================================================
PORT=3009
APP_NAME=M2R Email API
SERVICE_NAME=m2r-email-api
SUPPORT_URL=mailto:suporte@m2rseguros.com.br

# =================================================
# Rotas e CORS
# =================================================
URL_PREFIX=/api/v1
URL_INTERNAL=http://localhost:3009
URL_EXTERNAL=http://localhost:3009
CORS_ORIGINS=http://localhost:3000

# =================================================
# Messaging do Projeto
# =================================================
AMQP_EXCHANGE=m2ria.email
AMQP_DLX_EXCHANGE=m2ria.dlx
AMQP_QUEUE=m2r-email-api.send
AMQP_BINDINGS=email.send.#
AMQP_PREFETCH=10

# =================================================
# Scheduler
# =================================================
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULER_BATCH=100

# =================================================
# Cache / Sender
# =================================================
INTEGRATION_CACHE_TTL_SECONDS=300
SENDER_DEFAULT_TIMEOUT_MS=30000
